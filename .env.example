# 새 Vercel 프로젝트 전용. 기존 chaeun-makearoad.com 프로젝트에는 넣지 마세요.
# 이 값들은 서버에만 두고, 코드나 Git에는 넣지 마세요.

# 주문·직원·로그인 저장. 없으면 서버리스에서 데이터가 요청마다 사라집니다.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# 로그인 쿠키가 붙을 공개 주소. 도메인 연결 후 이 값으로 고정하세요.
BETTER_AUTH_URL=https://studio.chaeun-makearoad.com

# 32자 이상 임의 문자열. openssl rand -hex 32
BETTER_AUTH_SECRET=

# 선택. 없으면 AI 그림 생성은 꺼지고, 편집실의 로컬 시안·검수·영상감독은 그대로 동작합니다.
XAI_API_KEY=
OPENAI_API_KEY=
