# 새 Vercel 프로젝트 전용. 기존 chaeun-makearoad.com 프로젝트에는 넣지 마세요.
# 이 값들은 서버에만 두고, 코드나 Git에는 넣지 마세요.

# 주문·직원·로그인 저장. Vercel에서는 필수입니다. 없으면 회원가입이 실패합니다.
# Neon/Supabase 등 PostgreSQL 연결 문자열. 빌드와 런타임 모두에 넣으세요.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# 스키마는 배포 시 `npm run build` 안의 db:migrate 가 적용하고,
# 서버가 켜질 때도 같은 migrations/*.sql 을 한 번만 다시 적용합니다.
# 직접 실행: DATABASE_URL=... npm run db:migrate

# 로그인 쿠키가 붙을 공개 주소. 도메인 연결 후 이 값으로 고정하세요.
BETTER_AUTH_URL=https://studio.chaeun-makearoad.com

# 32자 이상 임의 문자열. openssl rand -hex 32
BETTER_AUTH_SECRET=

# 선택. 없으면 AI 그림 생성은 꺼지고, 편집실의 로컬 시안·검수·영상감독은 그대로 동작합니다.
XAI_API_KEY=
OPENAI_API_KEY=
